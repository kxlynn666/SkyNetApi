# Servidor
PORT=3000
NODE_ENV=development
# Ative somente quando a aplicação estiver atrás de um proxy confiável (ex.: Railway).
TRUST_PROXY=false

# Administrador inicial
# Use 12 a 128 caracteres em produção. Se ficar vazio, o servidor gera uma senha aleatória no primeiro boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Contas
AUTO_ACTIVATE_ACCOUNTS=false
SESSION_DAYS=7
MAX_KEYS_PER_ACCOUNT=10
MAX_UPLOADS_PER_ACCOUNT=100
MAX_GENERATIONS_PER_ACCOUNT=200

# Uploads e geração
MAX_UPLOAD_MB=15
MAX_REMOTE_IMAGE_MB=15
CARD_RATE_LIMIT_PER_MINUTE=30

# CORS
# Deixe vazio para aceitar somente a própria origem no navegador.
# Para várias origens, separe por vírgula.
CORS_ORIGINS=

# Fonte opcional
FONT_PATH=
